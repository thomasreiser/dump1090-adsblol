  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v2Aircraft": {
      "type": "object",
      "properties": {
        "hex": {
          "type": "string",
          "title": "24-bit ICAO hex, lowercase"
        },
        "type": {
          "type": "string",
          "description": "origin type: \"adsb_icao\", \"adsb_icao_nt\", \"mlat\", \"tisb\", ..."
        },
        "flight": {
          "type": "string",
          "title": "callsign / flight number, padded to 8 chars on the wire — kept as-received"
        },
        "r": {
          "type": "string",
          "title": "registration, from the optional aircraft DB"
        },
        "t": {
          "type": "string",
          "title": "ICAO type designator, from the optional aircraft DB"
        },
        "alt_baro": {
          "type": "integer",
          "format": "int32",
          "title": "barometric altitude in feet. 0 when `ground` is true. adsb.lol serialises\n\"ground\" as a string here; we keep it numeric for proto-friendliness"
        },
        "ground": {
          "type": "boolean"
        },
        "gs": {
          "type": "number",
          "format": "double",
          "title": "ground speed in knots"
        },
        "track": {
          "type": "number",
          "format": "double",
          "title": "true track over ground in degrees"
        },
        "baro_rate": {
          "type": "integer",
          "format": "int32",
          "title": "barometric vertical rate, ft/min"
        },
        "squawk": {
          "type": "string",
          "title": "Mode A squawk, 4 octal digits"
        },
        "emergency": {
          "type": "string",
          "description": "emergency state: \"none\", \"general\", \"lifeguard\", ..."
        },
        "category": {
          "type": "string",
          "title": "aircraft category (A0..A7, B0..B7, ...)"
        },
        "lat": {
          "type": "number",
          "format": "double"
        },
        "lon": {
          "type": "number",
          "format": "double"
        },
        "seen_pos": {
          "type": "number",
          "format": "double",
          "title": "seconds since the last position update"
        },
        "seen": {
          "type": "number",
          "format": "double",
          "title": "seconds since any message from this aircraft"
        },
        "messages": {
          "type": "number",
          "format": "double",
          "title": "total SBS messages received for this hex since the tracker first heard it.\nEncoded as double so protojson emits a number (int64 would be a string)"
        },
        "alert": {
          "type": "integer",
          "format": "int32"
        },
        "spi": {
          "type": "integer",
          "format": "int32"
        },
        "dst": {
          "type": "number",
          "format": "double",
          "title": "distance from the query point in nautical miles. Only populated by\n/v2/lat/lon/dist and /v2/closest"
        }
      },
      "title": "Aircraft is a snapshot of a tracked target. Anything not derivable from SBS\nis omitted by the gateway"
    },
    "v2V2Response": {
      "type": "object",
      "properties": {
        "ac": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v2Aircraft"
          }
        },
        "msg": {
          "type": "string"
        },
        "now": {
          "type": "number",
          "format": "double",
          "title": "server clock, unix-epoch milliseconds"
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "title": "number of aircraft in `ac`"
        },
        "ctime": {
          "type": "number",
          "format": "double",
          "title": "server clock again, kept for parity with adsb.lol"
        },
        "ptime": {
          "type": "number",
          "format": "double",
          "title": "processing time in milliseconds"
        }
      },
      "title": "V2Response mirrors the adsb.lol /v2 response envelope. Timestamps are doubles\n(not int64) so protojson emits JSON numbers instead of the canonical strings"
    }
  }
}
